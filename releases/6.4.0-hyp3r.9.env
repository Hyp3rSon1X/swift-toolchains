# Release manifest. One file per release; never edit a published one, add a new .<n> instead.
SWIFT_VERSION=6.4.0
RELEASE_ID=6.4.0-hyp3r.9
BASE_IMAGE=swift:6.4.0-noble
BASE_IMAGE_SLIM=swift:6.4.0-noble-slim
LIBDISPATCH_REPO=Hyp3rSon1X/swift-corelibs-libdispatch
LIBDISPATCH_REF=c28dbc510e6330f15542343e6bbb88037a97d815
FOUNDATION_REPO=Hyp3rSon1X/swift-corelibs-foundation
FOUNDATION_REF=2eb0e1f820d59fb1f7622a564cfb83c9d01b6b14
SWIFT_FOUNDATION_TAG=swift-6.4.0-RELEASE
SWIFT_FOUNDATION_ICU_TAG=swift-6.4.0-RELEASE
SWIFT_COLLECTIONS_TAG=1.1.6
FIXES="SC-0001: libdispatch use-after-free in the Linux epoll backend, SIGSEGV in _dispatch_event_loop_drain (swiftlang/swift-corelibs-libdispatch#949); backport of upstream PR #965 onto swift-6.4.0-RELEASE. SC-0002: Foundation Process on Linux over-reads dirent.d_name in findMaximumOpenFromProcSelfFD, intermittent SIGSEGV (swiftlang/swift-corelibs-foundation#5472); backport of upstream commit 81eb85a2 onto swift-6.4.0-RELEASE. SC-0004: the optimizer moved a class field-offset load above the allocation of the first instance (metadata accessors are modelled as readnone), so the first object of a class with a non-constant layout could get a field store over its isa pointer, intermittent SIGSEGV or silent heap corruption in -O builds; fixed in swift-frontend (LLVM alias analysis of swift_allocObject), the Linux images and tarballs carry the rebuilt compiler SC-0006: #isolation in nonisolated(nonsending) code (the default under NonisolatedNonsendingByDefault) ignored its contextual type, e.g. #isolation === MainActor.shared, so -O builds aborted in the LLVM verifier ('PHINode should have one entry for each predecessor', swiftlang/swift#92798); now converted, and types (any Actor)? cannot convert to are diagnosed like in @MainActor code (#isolation != nil there becomes an error; write (#isolation as (any Actor)?) != nil). SC-0019: #isolation in nonisolated(nonsending) code was consumed without a copy, so e.g. String(describing: #isolation) over-released the calling actor (deinit while running, then SIGSEGV; swiftlang/swift#92799). Both fixed in swift-frontend; the Linux images and tarballs carry the rebuilt compiler."
# Patched Static Linux SDK (musl): the official bundle below with libdispatch.a and libFoundation.a rebuilt from the refs above.
STATIC_SDK_VERSION=0.1.0
STATIC_SDK_URL=https://download.swift.org/swift-6.4.0-release/static-sdk/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE_static-linux-0.1.0.artifactbundle.tar.gz
STATIC_SDK_SHA256=47d2fd89eebfdf9eb4d536b6710414297f755c17926cdebc4742c08982b40a9e
# Compiler overlay (SC-0004, SC-0006, SC-0019): swift-frontend rebuilt from the ref below plus the unmodified swift-6.4.0-RELEASE
# LLVM/Clang/cmark/swift-syntax/string-processing trees, release build without assertions, swapped into the official toolchain.
# The static SDK's own libraries do not depend on the compiler fix; code built against it still uses the host compiler.
SWIFT_REPO=Hyp3rSon1X/swift
SWIFT_REF=0f6c165e2464335fb557b6d54ff442f092a44346
SWIFT_UPSTREAM_TAG=swift-6.4.0-RELEASE
