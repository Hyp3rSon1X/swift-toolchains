# macOS toolchain release manifest. One file per release; never edit a published one, add a new .<n> instead.
# Built locally on Apple silicon (a full compiler build does not fit GitHub's macOS runners), assets uploaded to
# the GitHub release swift-6.4.2-hyp3r.13. macOS 6.4.2-hyp3r.12 plus one compiler fix (SC-0055: a WASI async main installs the main
# module's DefaultExecutorFactory without -disable-availability-checking); the ld shim, the Span back-deployment library and the
# SwiftPM/SwiftBuild of swiftpm-6.4.2-hyp3r.3 are byte for byte those of .12.
SWIFT_VERSION=6.4.2
RELEASE_ID=6.4.2-hyp3r.13
PLATFORM=macos
ARCHS=arm64
TOOLCHAIN_ID=dev.hyp3r.swift.6.4.2-hyp3r.13
TOOLCHAIN_VERSION_PLIST=6.4.2.20261128113
FIXES="SC-0004: -O could move a class field-offset (Wvd) load above swift_allocObject, so the first instance's field store overwrote its isa (SwiftAA reported swift_allocObject as NoModRef); fix in lib/LLVMPasses/LLVMSwiftAA.cpp, not upstream yet; SC-0006: #isolation in nonisolated(nonsending) code ignored its contextual type (-O abort in the LLVM verifier, swiftlang/swift#92798); SC-0019: #isolation in nonisolated(nonsending) code consumed without a copy, actor over-release (swiftlang/swift#92799); both in lib/SILGen/SILGenExpr.cpp and lib/Sema/TypeCheckConcurrency.cpp, not upstream yet; SC-0005: typed-throws closure passed to a generic untyped-throws parameter (Task {}) crashed the compiler or corrupted the error (swiftlang/swift#92312, 6.4 regression), fix in lib/SIL/IR/AbstractionPattern.cpp; SC-0003: -O async functions taking an argument coerced through a stack temporary lost their spilled self/arguments (IRGen lifetime markers sized in bits, not bytes), backport of upstream swiftlang/swift#91312 (fe3020b7c6d, main only), lib/IRGen/GenCall.cpp; SC-0022: typed-throws closure at a type-parameter (opaque) abstraction pattern crashed SILGen, fix in lib/SILGen/SILGenProlog.cpp, not upstream yet; SC-0023: in nonisolated(nonsending) code every call passing #isolation to an isolated parameter counted as an isolation crossing since our SC-0006 fix (hyp3r.8 to .12), so valid code was rejected by region isolation (for await over non-Sendable elements, #expect(processExitsWith:)); fix in lib/Sema/TypeCheckConcurrency.cpp, not upstream; SC-0032: optional-chained mutation of actor-isolated state across await (dict[k]?.x = await f(), ?.x += await, ?.append(await f())) holds the access across the suspension and loses updates; new Sema warning in group ActorIsolatedOptionalChainSuspension at exactly the affected sites (-Werror turns it into an error), diagnostic only, no codegen change; fix in lib/Sema/TypeCheckConcurrency.cpp and include/swift/AST/DiagnosticsSema.def and DiagnosticGroups.def, not upstream yet; SC-0033: SwiftBuild planned whole-module outputs (the -primary.d dependency file) for a target whose OTHER_SWIFT_FLAGS (SwiftPM unsafeFlags) turned WMO off with -no-whole-module-optimization on top of the SwiftPM release default -Owholemodule, so the build failed with unable to open dependencies file; the reverse (-wmo in a non-WMO configuration) failed the same way. The last WMO flag in OTHER_SWIFT_FLAGS now decides; fix in Sources/SWBCore/SpecImplementations/Tools/SwiftCompiler.swift, not upstream yet; SC-0034: with -sanitize=thread, SILGen put TSan inout instrumentation on object projections (the load_borrow of a ~Copyable self, struct_extract), which kept SILGenCleanup from narrowing a let read to the stored property, so legal disjoint accesses (inner.add(&box.value)) were rejected as overlapping; the builtin is now emitted only for addresses; fix in lib/SILGen/SILGenLValue.cpp, not upstream yet; SC-0035: -O/-Osize compiler crash 'SIL verification failed: read-only scope invalidated by a local write' for a ~Copyable struct whose mutating method calls a throwing/rethrows function and is inlined (the move-only address checker destroyed the inout field in a dead-end error block); backport of upstream swiftlang/swift#90163 (2222a7a2121, main only); SC-0036: -Onone code read 16-byte aligned values (SIMD4<Float>, UInt128 payloads) passed or returned directly through an 8-byte aligned coercion temporary forwarded by the visitStoreInst peepholes (x86_64: movaps, signal 11; swiftlang/swift#93129); fix in lib/IRGen/IRGenSIL.cpp, not upstream yet; SC-0037: an Array (or another owned value) returned by a throwing call and borrowed as .span or .span.bytes directly in another call's argument (total(try make(n).span)) crashed the compiler at every optimization level with 'Instruction does not dominate all uses' (swiftlang/swift#92412): LifetimeDependenceScopeFixup destroyed the result on the call's error path; the extended scope now begins in the block that receives the result; fix in SwiftCompilerSources LifetimeDependenceScopeFixup.swift, not upstream yet; SC-0029: an unannotated closure parameter of a noncopyable type that the closure's contextual or inferred type borrows (withHandle { handle in ... } with (borrowing Handle) -> T) crashed the compiler (SIL verifier, 'Have operand with incompatible ownership?!', exit 134) when an escaping closure or a local function captured it; capture by a local function is valid and now compiles, capture by an escaping closure is now diagnosed ('cannot be captured by an escaping closure since it is a borrowed parameter'); adapted backport of swiftlang/swift#93618 (main only), fix in lib/SIL/IR/TypeLowering.cpp; SC-0043: false warning 'no calls to throwing functions occur within try expression' on try #require(...) in a local function when the enclosing body declares a local type and the job skips function bodies (SwiftPM emit-module jobs, -experimental-skip-non-inlinable-function-bodies-without-types; also a local function in a stored-property initializer closure): Sema checked the effects of local functions whose bodies were skipped; same fix as upstream swiftlang/swift#91082 (main only), fix in lib/Sema/TypeCheckEffects.cpp; SC-0055: for WebAssembly (WASI) targets an async main emitted no swift_createExecutors(factory:) call, so a DefaultExecutorFactory declared by the main module (top level or in the @main type) was ignored and the program stayed on the SDK's cooperative executor unless the module was compiled with -disable-availability-checking (which also hides real availability errors): SILGen required the custom-executor feature in the runtime, which 6.4.2 marks as a future runtime version; WASI programs always link the Swift runtime of their SDK, so the function is now treated as available there; without a factory the call installs PlatformExecutorFactory at the start of main instead of on first use (same executors); fix in lib/SILGen/SILGenFunction.cpp, not upstream yet"
# Base: the official swift.org toolchain, changed by scripts/macos/assemble-toolchain.sh:
# - usr/bin/swift-frontend: built from SWIFT_REF (SC-0003 + SC-0004 + SC-0005 + SC-0006 + SC-0019 + SC-0022 + SC-0023 + SC-0032 + SC-0029 + SC-0034 + SC-0035 + SC-0036 + SC-0037 + SC-0043 + SC-0055; SwiftPM below: SC-0033), relinked against
#   the base toolchain's lib_CompilerSwift*.dylib; compiler tag swift-6.4.2-hyp3r.13 (incremental build in the Ninja-Release tree of 6.4.2-hyp3r.12: reconfigure with the new tag, rebuild swift-frontend);
# - usr/bin/ld (same as 6.4.0-hyp3r.5 to 6.4.2-hyp3r.9): scripts/macos/ld-shim.sh, runs the active developer directory's linker; fixes Xcode's
#   package-manifest linking ("posix_spawn failed", swiftlang/swift#89035);
# - usr/lib/swift-6.2/macosx/libswiftCompatibilitySpan.dylib: rebuilt by scripts/macos/build-span-shim.sh from SWIFT_REF (Span sources as in
#   swift-6.4.2-RELEASE) with SWIFT_VERSION=SWIFT_COMPILER_VERSION=6.4.2: LC_ID_DYLIB current_version 6.4.2 and libswiftCore dependency 6.4.2 on
#   x86_64/arm64/arm64e, embedded plist CFBundleShortVersionString 6.4.2 and CFBundleVersion 6.4.2 (Xcode 27.2's copy: 6.4.2 / 6.4.2.1.9);
#   exports identical to Xcode 27.2's and to the 6.4.0 build that 6.4.0-hyp3r.6 to 6.4.2-hyp3r.8 carried (current_version 6.4.0); the file is the one of 6.4.2-hyp3r.9 (same bytes, SPAN_SHIM_SHA256).
# - SwiftPM (usr/bin/swift-package and its multi-call links, usr/libexec/swift/pm/swiftpm-testing-helper, usr/lib/swift/pm/{ManifestAPI,PluginAPI}, usr/share/pm):
#   the files of the SwiftPM-only toolchain 6.4.2-hyp3r.3 (SWIFTPM_PAYLOAD), not rebuilt: our SwiftPM fork at SWIFTPM_REF plus swift-build at SWIFT_BUILD_REF (SC-0033);
#   swift.org's binary PackageDescription/PackagePlugin modules (arm64 and x86_64) are replaced by textual .swiftinterface files; swift-build-tool and libllbuildSwift stay.
FIXES_PACKAGING="Xcode manifest linking (ld shim); Span back-deployment library current_version 6.4.2 and arm64e slice; SwiftPM/SwiftBuild with the PackageDescription and PackagePlugin modules as textual .swiftinterface files (Xcode's layout), so the active compiler rebuilds them"
BASE_TOOLCHAIN_URL=https://download.swift.org/swift-6.4.2-release/xcode/swift-6.4.2-RELEASE/swift-6.4.2-RELEASE-osx.pkg
BASE_TOOLCHAIN_ID=org.swift.642202610261a
BASE_TOOLCHAIN_VERSION=6.4.2.20261026101
BASE_TOOLCHAIN_PKG_SHA256=0a7d8489900d21dbf5f0187cb570e646a4c0226d0ddef2cbde8c7f54dfe79736
# Sources: swift-6.4.2-RELEASE pins: llvm-project and swift-experimental-string-processing moved to the 6.4.2 tags; swift-syntax, cmark and
# swift-driver are unchanged from 6.4.1. swift = the release tag + the fixes (5f0d6c8a868 = d596e99f9a9 of .12 + SC-0055).
SWIFT_REPO=Hyp3rSon1X/swift
SWIFT_REF=5f0d6c8a8680269c39e91e987b25bfaa8342818e
SWIFT_BRANCH=hyp3r/release/6.4.2
SWIFT_BASE_TAG=swift-6.4.2-RELEASE
LLVM_PROJECT_REF=fb5f84d903a3b4e7aea15cd5666598a46f56c833
SWIFT_SYNTAX_REF=050f1a346fbbac0ca2cfb15a95274f7bd1cf0ccf
CMARK_REF=924936d0427cb25a61169739a7660230bffa6ea6
STRING_PROCESSING_REF=7581e7b803d2ccc58409e45e1bfde40146cb8e41
SWIFT_DRIVER_REF=174567a5681a9a949bcd52f821deb8fa65105434
# Build host: macOS 27.2, Xcode 27.2 (27B52, host Swift swiftlang-6.4.2.1.9), cmake/ninja from Homebrew.
# The compiler tag distinguishes the frontend (print-target-info swiftCompilerTag); the serialization tag stays
# empty like swift.org's, so the official binary .swiftmodule files keep loading.
BUILD_ENV="TOOLCHAIN_VERSION=swift-6.4.2-hyp3r.13 (incremental: the build/Ninja-Release tree of 6.4.2-hyp3r.12, source 5f0d6c8a868, cmake reconfigure with the new tag, ninja swift-frontend; SWIFT_REVISION embedded = SWIFT_REF; Span: reused from 6.4.2-hyp3r.9, signed bytes equal to SPAN_SHIM_SHA256; build-slot 4 jobs)"
BUILD_COMMAND="swift/utils/build-script --build-subdir=Ninja-Release --release-debuginfo --no-assertions --compiler-vendor=apple --swift-darwin-supported-archs arm64 --skip-ios --skip-tvos --skip-watchos --skip-xros --skip-build-benchmarks --skip-early-swift-driver --no-llvm-include-tests --build-swift-dynamic-stdlib=0 --build-swift-static-stdlib=0 --build-swift-dynamic-sdk-overlay=0 --build-embedded-stdlib=0 --build-swift-remote-mirror=0 --build-swift-libexec=0 --build-swift-clang-overlays=0 --extra-cmake-options='-DCMAKE_C_FLAGS=-gline-tables-only -DCMAKE_CXX_FLAGS=-gline-tables-only' --jobs 4"
# build-script stops after configuring swift (with the stdlib skipped it still asks ninja for
# swift-test-stdlib-macosx-arm64, an unknown target); the compiler is then built directly:
SPAN_SHIM_COMMAND="scripts/macos/build-span-shim.sh <build-script log> build/Ninja-Release 6.4.2"
BUILD_COMMAND_2="cmake -DSWIFT_VERSION=6.4.2 -DSWIFT_TOOLCHAIN_VERSION=swift-6.4.2-hyp3r.13 build/Ninja-Release/swift-macosx-arm64; ninja -j 4 -C build/Ninja-Release/swift-macosx-arm64 swift-frontend (both inside build-slot)"
ASSEMBLE_COMMAND="scripts/macos/assemble-toolchain.sh <expanded swift-6.4.2-RELEASE-osx.pkg Payload> build/Ninja-Release/swift-macosx-arm64 <out> 6.4.2-hyp3r.13 6.4.2.20261128113 'SC-0003 SC-0004 SC-0005 SC-0006 SC-0019 SC-0022 SC-0023 SC-0029 SC-0032 SC-0033 SC-0034 SC-0035 SC-0036 SC-0037 SC-0043 SC-0055' build/Ninja-Release/swift-span-macosx/out/libswiftCompatibilitySpan.dylib"
OVERLAY_COMMAND="scripts/macos/overlay-swiftpm.sh <assembled swift-6.4.2-hyp3r.13.xctoolchain> <swiftpm-6.4.2-hyp3r.3-macos-arm64.xctoolchain extracted from SWIFTPM_PAYLOAD> (run after assemble-toolchain.sh, before package-toolchain.sh; replaces usr/bin/swift-package and its symlinks, usr/libexec/swift/pm/swiftpm-testing-helper, usr/lib/swift/pm and usr/share/pm, keeps swift-build-tool and libllbuildSwift, reseals the bundle ad hoc)"
PACKAGE_COMMAND="scripts/macos/package-toolchain.sh <out> 6.4.2-hyp3r.13 6.4.2.20261128113 arm64"
ASSET_PKG=swift-6.4.2-hyp3r.13-macos-arm64.pkg
ASSET_PKG_SHA256=efcc39f2883fc89b2a7ad13fd31628d299d6eb071069295741afefa5ff455aeb
ASSET_TAR=swift-6.4.2-hyp3r.13-macos-arm64.xctoolchain.tar.xz
ASSET_TAR_SHA256=70e7d838aeede98d65b483d64aacad33acf7ec9a1ca859cebef060f42064099b
SWIFT_FRONTEND_SHA256=0f3bc6780a06b87619f2eee839c6ace1011c5663180ded31c9e24804340c75b1
LD_SHIM_SHA256=d2d0b68bb45a489cb4b919c4137ee491589d584137080af9a9c513015b0bd1dc
SPAN_SHIM_SHA256=4395032dca7b41d740df7ff91485dafa08c1ff388a1f9d003dcff83b3a8d0e41
SWIFT_PACKAGE_SHA256=539126a20e0fbcd26688439062aa0fd0f46fa0fd23afe36154350e2820bc4ceb
