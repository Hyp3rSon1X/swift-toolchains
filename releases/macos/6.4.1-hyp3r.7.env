# macOS SwiftPM-only toolchain (no compiler): our SwiftPM 6.4.1 + patched swift-build; compiler tools fall back to Xcode.
# Built and published locally on the Mac mini (not by build.yml). Select with TOOLCHAINS=$TOOLCHAIN_ID and call
# xcrun swift-build / swift-test / swift-package directly (swift build goes through Xcode's swift and Xcode's SwiftPM).
SWIFT_VERSION=6.4.1
RELEASE_ID=6.4.1-hyp3r.7
PLATFORM=macos
ARCHS=arm64
KIND=swiftpm-only
TOOLCHAIN_ID=dev.hyp3r.swiftpm.6.4.1-hyp3r.7
TOOLCHAIN_VERSION_PLIST=6.4.1.20261025107
FIXES="SC-0033: SwiftBuild planned whole-module outputs (the -primary.d dependency file) for a target whose OTHER_SWIFT_FLAGS (SwiftPM unsafeFlags) turned WMO off with -no-whole-module-optimization on top of the SwiftPM release default -Owholemodule, so the build failed with unable to open dependencies file; the reverse (-wmo in a non-WMO configuration) failed the same way. The last WMO flag in OTHER_SWIFT_FLAGS now decides; fix in Sources/SWBCore/SpecImplementations/Tools/SwiftCompiler.swift, not upstream yet"
SWIFT_BUILD_REPO=Hyp3rSon1X/swift-build
SWIFT_BUILD_REF=743906849eb10cd3255db65a540d3d21581fb541
SWIFT_BUILD_BRANCH=hyp3r/release/6.4.1
SWIFT_BUILD_BASE_TAG=swift-6.4.1-RELEASE
SWIFT_BUILD_FIX_BRANCH=fix/SC-0033-no-wmo-flag@818bacdf061a29974b3e4379d9c40791031b91bd
SWIFTPM_REPO=Hyp3rSon1X/swift-package-manager
SWIFTPM_REF=4429e8becef360e2a26f4797caa8eb245198f07a
SWIFTPM_RESOLVED="swift-argument-parser@309a47b2b1d9b5e991f36961c983ecec72275be3 swift-asn1@3b6410f7dee09eb33cdd26260c5fd47fda19b0e2 swift-certificates@386001a92200c70fd06217b3ccad58d7226edb84 swift-collections@c11818f3cae0780656baa430b49e7f163f08dffd swift-crypto@d79c573e1b400d670ed12c0cb29d33f2c0f5ab70 swift-docc-plugin@647c708be89f834fa6a6d4945442793a77ddf5b6 swift-docc-symbolkit@b45d1f2ed151d057b54504d653e0da5552844e34 swift-driver@174567a5681a9a949bcd52f821deb8fa65105434 swift-llbuild@ab6421207b9e4971c94e97c5832a3d8a4cae9092 swift-syntax@050f1a346fbbac0ca2cfb15a95274f7bd1cf0ccf swift-system@61e4ca4b81b9e09e2ec863b00c340eb13497dac6 swift-toolchain-sqlite@c0ecc1e0fd1b4fbc38db1efa6113bc12c2a4e559 swift-tools-protocols@4345e69c5572ec3d1f737fba90bca024b32da5cf swift-tools-support-core@75a4f8586889fff3813f88ac3a0179ad568247e0"
BUILD_HOST="Mac mini arm64, macOS 27.0.1, Xcode 27.1 (27A9275), Apple Swift 6.4 (swiftlang-6.4.0.34.1)"
BUILD_COMMAND="BUNDLE_ID=dev.hyp3r.swiftpm.6.4.1-hyp3r.7 TC_VERSION=6.4.1.20261025107 scripts/macos/build-swiftpm-toolchain.sh 743906849eb10cd3255db65a540d3d21581fb541 4429e8becef360e2a26f4797caa8eb245198f07a swiftpm-6.4.1-hyp3r.7-macos-arm64"
ASSET_TAR=swiftpm-6.4.1-hyp3r.7-macos-arm64.tar.xz
