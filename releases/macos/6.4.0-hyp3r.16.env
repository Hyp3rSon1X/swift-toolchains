# macOS toolchain release manifest. One file per release; never edit a published one, add a new .<n> instead.
# Built locally on Apple silicon (a full compiler build does not fit GitHub's macOS runners), assets uploaded to
# the GitHub release swift-6.4.0-hyp3r.16.
SWIFT_VERSION=6.4.0
RELEASE_ID=6.4.0-hyp3r.16
PLATFORM=macos
ARCHS=arm64
TOOLCHAIN_ID=dev.hyp3r.swift.6.4.0-hyp3r.16
TOOLCHAIN_VERSION_PLIST=6.4.20261014116
FIXES="SC-0004: -O could move a class field-offset (Wvd) load above swift_allocObject, so the first instance's field store overwrote its isa (SwiftAA reported swift_allocObject as NoModRef); fix in lib/LLVMPasses/LLVMSwiftAA.cpp, not upstream yet; SC-0006: #isolation in nonisolated(nonsending) code ignored its contextual type (-O abort in the LLVM verifier, swiftlang/swift#92798); SC-0019: #isolation in nonisolated(nonsending) code consumed without a copy, actor over-release (swiftlang/swift#92799); both in lib/SILGen/SILGenExpr.cpp and lib/Sema/TypeCheckConcurrency.cpp, not upstream yet; SC-0005: typed-throws closure passed to a generic untyped-throws parameter (Task {}) crashed the compiler or corrupted the error (swiftlang/swift#92312, 6.4 regression), fix in lib/SIL/IR/AbstractionPattern.cpp; SC-0003: -O async functions taking an argument coerced through a stack temporary lost their spilled self/arguments (IRGen lifetime markers sized in bits, not bytes), backport of upstream swiftlang/swift#91312 (fe3020b7c6d, main only), lib/IRGen/GenCall.cpp; SC-0022: typed-throws closure at a type-parameter (opaque) abstraction pattern crashed SILGen, fix in lib/SILGen/SILGenProlog.cpp, not upstream yet; SC-0023: in nonisolated(nonsending) code every call passing #isolation to an isolated parameter counted as an isolation crossing since our SC-0006 fix (hyp3r.8 to .12), so valid code was rejected by region isolation (for await over non-Sendable elements, #expect(processExitsWith:)); fix in lib/Sema/TypeCheckConcurrency.cpp, not upstream"
# Base: the official swift.org toolchain, changed by scripts/macos/assemble-toolchain.sh:
# - usr/bin/swift-frontend: built from SWIFT_REF (SC-0003 + SC-0004 + SC-0005 + SC-0006 + SC-0019 + SC-0022 + SC-0023), relinked against the base toolchain's
#   lib_CompilerSwift*.dylib; compiler tag swift-6.4.0-hyp3r.16 (Ninja-Release reconfigured with
#   -DSWIFT_TOOLCHAIN_VERSION=swift-6.4.0-hyp3r.16, then ninja swift-frontend);
# - usr/bin/ld (same as hyp3r.5 to .10): scripts/macos/ld-shim.sh, runs the active developer directory's linker; fixes Xcode's
#   package-manifest linking ("posix_spawn failed", swiftlang/swift#89035);
# - usr/lib/swift-6.2/macosx/libswiftCompatibilitySpan.dylib: rebuilt by scripts/macos/build-span-shim.sh from
#   the same sources with LC_ID_DYLIB current_version 6.4.0 (swift.org: 0.0.0); same exports and imports.
#   Slices x86_64 arm64 arm64e like Xcode 27's copy (swift.org: x86_64 arm64). The x86_64 and arm64 slices are
#   byte-identical to 6.4.0-hyp3r.5's input; the dylib is byte-identical to hyp3r.6's, .8's and .10's; arm64e is the arm64 build retargeted to arm64e-apple-macosx
#   (ptrauth ABI version 0, userspace, as Apple's slice).
FIXES_PACKAGING="Xcode manifest linking (ld shim); Span back-deployment library current_version 6.4.0 and arm64e slice"
BASE_TOOLCHAIN_URL=https://download.swift.org/swift-6.4.0-release/xcode/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-osx.pkg
BASE_TOOLCHAIN_ID=org.swift.640202609131a
BASE_TOOLCHAIN_VERSION=6.4.20260913101
# Sources: update-checkout scheme release/6.4.0. Checked 2026-10-11 with git ls-remote: all 53 checked-out
# repos are at their upstream pin (swift-6.4.0-RELEASE tag, or the scheme's version/commit for third-party
# repos); the swift-6.4.x-DEVELOPMENT-SNAPSHOT tags some show are extra tags on the same commits. Only swift
# differs (release tag + the fix).
SWIFT_REPO=Hyp3rSon1X/swift
SWIFT_REF=93a18d824b30b4ac1716efb6423db375131ba6ab
SWIFT_BRANCH=hyp3r/release/6.4
SWIFT_BASE_TAG=swift-6.4.0-RELEASE
LLVM_PROJECT_REF=903b9faaae5c43ecc9b7e33f8db9c94c7429374a
SWIFT_SYNTAX_REF=050f1a346fbbac0ca2cfb15a95274f7bd1cf0ccf
CMARK_REF=924936d0427cb25a61169739a7660230bffa6ea6
STRING_PROCESSING_REF=bf9cd9a0cfb0481f0825509aeb81ff3135bac250
SWIFT_DRIVER_REF=174567a5681a9a949bcd52f821deb8fa65105434
# Build host: macOS 27.0.1, Xcode 27.0 (27A266a, host Swift swiftlang-6.4.0.34.1), cmake/ninja from Homebrew.
# The compiler tag distinguishes the frontend (print-target-info swiftCompilerTag); the serialization tag stays
# empty like swift.org's, so the official binary .swiftmodule files keep loading.
BUILD_ENV="TOOLCHAIN_VERSION=swift-6.4.0-hyp3r.16 (same build tree as hyp3r.12, reconfigured with cmake -DSWIFT_TOOLCHAIN_VERSION=swift-6.4.0-hyp3r.16, then nice ninja -j6 swift-frontend)"
BUILD_COMMAND="swift/utils/build-script --build-subdir=Ninja-Release --release-debuginfo --no-assertions --compiler-vendor=apple --swift-darwin-supported-archs arm64 --skip-ios --skip-tvos --skip-watchos --skip-xros --skip-build-benchmarks --skip-early-swift-driver --no-llvm-include-tests --build-swift-dynamic-stdlib=0 --build-swift-static-stdlib=0 --build-swift-dynamic-sdk-overlay=0 --build-embedded-stdlib=0 --build-swift-remote-mirror=0 --build-swift-libexec=0 --build-swift-clang-overlays=0 --extra-cmake-options='-DCMAKE_C_FLAGS=-gline-tables-only -DCMAKE_CXX_FLAGS=-gline-tables-only' --jobs 8"
# build-script stops after configuring swift (with the stdlib skipped it still asks ninja for
# swift-test-stdlib-macosx-arm64, an unknown target); the compiler is then built directly:
BUILD_COMMAND_2="ninja -C build/Ninja-Release/swift-macosx-arm64 -j8 swift-frontend"
SPAN_SHIM_COMMAND="scripts/macos/build-span-shim.sh <build-script log> build/Ninja-Release 6.4.0"
ASSEMBLE_COMMAND="scripts/macos/assemble-toolchain.sh <base.xctoolchain> build/Ninja-Release/swift-macosx-arm64 <out> 6.4.0-hyp3r.16 6.4.20261014116 'SC-0003 SC-0004 SC-0005 SC-0006 SC-0019 SC-0022 SC-0023' <hyp3r.8 toolchain>/usr/lib/swift-6.2/macosx/libswiftCompatibilitySpan.dylib"
PACKAGE_COMMAND="scripts/macos/package-toolchain.sh <out> 6.4.0-hyp3r.16 6.4.20261014116 arm64"
ASSET_PKG=swift-6.4.0-hyp3r.16-macos-arm64.pkg
ASSET_PKG_SHA256=dc05e629b693f0e880d4e20e8a7c471127845170056e134abc1d15d4862c87ad
ASSET_TAR=swift-6.4.0-hyp3r.16-macos-arm64.xctoolchain.tar.xz
ASSET_TAR_SHA256=2f566098560affe6cd73ef73314a5ce8f32aa13016f54837ad60157a785653ed
SWIFT_FRONTEND_SHA256=b4c9f6d377897f022c050231ae97b11e27f1c0f9062004c3c85fe1de786dbe86
LD_SHIM_SHA256=d2d0b68bb45a489cb4b919c4137ee491589d584137080af9a9c513015b0bd1dc
