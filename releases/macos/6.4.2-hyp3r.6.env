# macOS toolchain release manifest. One file per release; never edit a published one, add a new .<n> instead.
# Built locally on Apple silicon (a full compiler build does not fit GitHub's macOS runners), assets uploaded to
# the GitHub release swift-6.4.2-hyp3r.6. The nine fixes of macOS 6.4.2-hyp3r.2 plus SC-0035 and SC-0036 (eleven fixes;
# Linux 6.4.2-hyp3r.5 carries the same compiler source).
SWIFT_VERSION=6.4.2
RELEASE_ID=6.4.2-hyp3r.6
PLATFORM=macos
ARCHS=arm64
TOOLCHAIN_ID=dev.hyp3r.swift.6.4.2-hyp3r.6
TOOLCHAIN_VERSION_PLIST=6.4.2.20261116106
FIXES="SC-0004: -O could move a class field-offset (Wvd) load above swift_allocObject, so the first instance's field store overwrote its isa (SwiftAA reported swift_allocObject as NoModRef); fix in lib/LLVMPasses/LLVMSwiftAA.cpp, not upstream yet; SC-0006: #isolation in nonisolated(nonsending) code ignored its contextual type (-O abort in the LLVM verifier, swiftlang/swift#92798); SC-0019: #isolation in nonisolated(nonsending) code consumed without a copy, actor over-release (swiftlang/swift#92799); both in lib/SILGen/SILGenExpr.cpp and lib/Sema/TypeCheckConcurrency.cpp, not upstream yet; SC-0005: typed-throws closure passed to a generic untyped-throws parameter (Task {}) crashed the compiler or corrupted the error (swiftlang/swift#92312, 6.4 regression), fix in lib/SIL/IR/AbstractionPattern.cpp; SC-0003: -O async functions taking an argument coerced through a stack temporary lost their spilled self/arguments (IRGen lifetime markers sized in bits, not bytes), backport of upstream swiftlang/swift#91312 (fe3020b7c6d, main only), lib/IRGen/GenCall.cpp; SC-0022: typed-throws closure at a type-parameter (opaque) abstraction pattern crashed SILGen, fix in lib/SILGen/SILGenProlog.cpp, not upstream yet; SC-0023: in nonisolated(nonsending) code every call passing #isolation to an isolated parameter counted as an isolation crossing since our SC-0006 fix (hyp3r.8 to .12), so valid code was rejected by region isolation (for await over non-Sendable elements, #expect(processExitsWith:)); fix in lib/Sema/TypeCheckConcurrency.cpp, not upstream; SC-0032: optional-chained mutation of actor-isolated state across await (dict[k]?.x = await f(), ?.x += await, ?.append(await f())) holds the access across the suspension and loses updates; new Sema warning in group ActorIsolatedOptionalChainSuspension at exactly the affected sites (-Werror turns it into an error), diagnostic only, no codegen change; fix in lib/Sema/TypeCheckConcurrency.cpp and include/swift/AST/DiagnosticsSema.def and DiagnosticGroups.def, not upstream yet; SC-0034: with -sanitize=thread, SILGen put TSan inout instrumentation on object projections (the load_borrow of a ~Copyable self, struct_extract), which kept SILGenCleanup from narrowing a let read to the stored property, so legal disjoint accesses (inner.add(&box.value)) were rejected as overlapping; the builtin is now emitted only for addresses; fix in lib/SILGen/SILGenLValue.cpp, not upstream yet; SC-0035: -O/-Osize compiler crash 'SIL verification failed: read-only scope invalidated by a local write' for a ~Copyable struct whose mutating method calls a throwing/rethrows function and is inlined (the move-only address checker destroyed the inout field in a dead-end error block); backport of upstream swiftlang/swift#90163 (2222a7a2121, main only); SC-0036: -Onone code read 16-byte aligned values (SIMD4<Float>, UInt128 payloads) passed or returned directly through an 8-byte aligned coercion temporary forwarded by the visitStoreInst peepholes (x86_64: movaps, signal 11; swiftlang/swift#93129); fix in lib/IRGen/IRGenSIL.cpp, not upstream yet"
# Base: the official swift.org toolchain, changed by scripts/macos/assemble-toolchain.sh:
# - usr/bin/swift-frontend: built from SWIFT_REF (SC-0003 + SC-0004 + SC-0005 + SC-0006 + SC-0019 + SC-0022 + SC-0023 + SC-0032 + SC-0034 + SC-0035 + SC-0036), relinked against
#   the base toolchain's lib_CompilerSwift*.dylib; compiler tag swift-6.4.2-hyp3r.6 (incremental build in the Ninja-Release tree of 6.4.2-hyp3r.2);
# - usr/bin/ld (same as 6.4.0-hyp3r.5 to 6.4.2-hyp3r.2): scripts/macos/ld-shim.sh, runs the active developer directory's linker; fixes Xcode's
#   package-manifest linking ("posix_spawn failed", swiftlang/swift#89035);
# - usr/lib/swift-6.2/macosx/libswiftCompatibilitySpan.dylib: byte-identical to 6.4.0-hyp3r.6 to 6.4.2-hyp3r.2 (current_version 6.4.0, arm64e slice);
#   its sources (stdlib/toolchain/CompatibilitySpan, stdlib/public/core/Span) did not change from 6.4.1 to 6.4.2.
FIXES_PACKAGING="Xcode manifest linking (ld shim); Span back-deployment library current_version 6.4.0 and arm64e slice"
BASE_TOOLCHAIN_URL=https://download.swift.org/swift-6.4.2-release/xcode/swift-6.4.2-RELEASE/swift-6.4.2-RELEASE-osx.pkg
BASE_TOOLCHAIN_ID=org.swift.642202610261a
BASE_TOOLCHAIN_VERSION=6.4.2.20261026101
BASE_TOOLCHAIN_PKG_SHA256=0a7d8489900d21dbf5f0187cb570e646a4c0226d0ddef2cbde8c7f54dfe79736
# Sources: swift-6.4.2-RELEASE pins: llvm-project and swift-experimental-string-processing moved to the 6.4.2 tags; swift-syntax, cmark and
# swift-driver are unchanged from 6.4.1. swift = the release tag + the fixes.
SWIFT_REPO=Hyp3rSon1X/swift
SWIFT_REF=7988d244532f2533937f918aab492af9eefb23d1
SWIFT_BRANCH=hyp3r/release/6.4.2
SWIFT_BASE_TAG=swift-6.4.2-RELEASE
LLVM_PROJECT_REF=fb5f84d903a3b4e7aea15cd5666598a46f56c833
SWIFT_SYNTAX_REF=050f1a346fbbac0ca2cfb15a95274f7bd1cf0ccf
CMARK_REF=924936d0427cb25a61169739a7660230bffa6ea6
STRING_PROCESSING_REF=7581e7b803d2ccc58409e45e1bfde40146cb8e41
SWIFT_DRIVER_REF=174567a5681a9a949bcd52f821deb8fa65105434
# Build host: macOS 27.2, Xcode 27.2 (27B52, host Swift swiftlang-6.4.2.1.9), cmake/ninja from Homebrew.
# The compiler tag distinguishes the frontend (print-target-info swiftCompilerTag); the serialization tag stays
# empty like swift.org's, so the official binary .swiftmodule files keep loading.
BUILD_ENV="TOOLCHAIN_VERSION=swift-6.4.2-hyp3r.6 (incremental: the build/Ninja-Release tree of 6.4.2-hyp3r.2 at 78dd2593993, checkout of SWIFT_REF, cmake reconfigure, ninja swift-frontend: 6 steps, 32 s, build-slot 4 jobs)"
BUILD_COMMAND="swift/utils/build-script --build-subdir=Ninja-Release --release-debuginfo --no-assertions --compiler-vendor=apple --swift-darwin-supported-archs arm64 --skip-ios --skip-tvos --skip-watchos --skip-xros --skip-build-benchmarks --skip-early-swift-driver --no-llvm-include-tests --build-swift-dynamic-stdlib=0 --build-swift-static-stdlib=0 --build-swift-dynamic-sdk-overlay=0 --build-embedded-stdlib=0 --build-swift-remote-mirror=0 --build-swift-libexec=0 --build-swift-clang-overlays=0 --extra-cmake-options='-DCMAKE_C_FLAGS=-gline-tables-only -DCMAKE_CXX_FLAGS=-gline-tables-only' --jobs 4"
# build-script stops after configuring swift (with the stdlib skipped it still asks ninja for
# swift-test-stdlib-macosx-arm64, an unknown target); the compiler is then built directly:
BUILD_COMMAND_2="cmake -DSWIFT_VERSION=6.4.2 -DSWIFT_TOOLCHAIN_VERSION=swift-6.4.2-hyp3r.6 build/Ninja-Release/swift-macosx-arm64; ninja -j 4 -C build/Ninja-Release/swift-macosx-arm64 swift-frontend (both inside build-slot)"
ASSEMBLE_COMMAND="scripts/macos/assemble-toolchain.sh <expanded swift-6.4.2-RELEASE-osx.pkg Payload> build/Ninja-Release/swift-macosx-arm64 <out> 6.4.2-hyp3r.6 6.4.2.20261116106 'SC-0003 SC-0004 SC-0005 SC-0006 SC-0019 SC-0022 SC-0023 SC-0032 SC-0034 SC-0035 SC-0036' <6.4.1-hyp3r.6 toolchain>/usr/lib/swift-6.2/macosx/libswiftCompatibilitySpan.dylib"
PACKAGE_COMMAND="scripts/macos/package-toolchain.sh <out> 6.4.2-hyp3r.6 6.4.2.20261116106 arm64"
ASSET_PKG=swift-6.4.2-hyp3r.6-macos-arm64.pkg
ASSET_PKG_SHA256=bb31058263876dd8ebe20839a3dd836a700b364e9b413f25373f7460c4f50f97
ASSET_TAR=swift-6.4.2-hyp3r.6-macos-arm64.xctoolchain.tar.xz
ASSET_TAR_SHA256=d7ed60de82fa26b38b797a5431187f8cd2b5e078330121ed7ad65a5d6f4908a8
SWIFT_FRONTEND_SHA256=9e42e2a677c957f643c8d7a08759d3c1f216401b228bb8f82a1ea1b2e76fa777
LD_SHIM_SHA256=d2d0b68bb45a489cb4b919c4137ee491589d584137080af9a9c513015b0bd1dc
SPAN_SHIM_SHA256=aa62d9ca47784c804f50bb29053179aa2e3ee6159851e6f21310e8af3294a0fa
