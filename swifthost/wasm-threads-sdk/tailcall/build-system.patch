                                   '-Xcc;-mthread-model;-Xcc;posix;'
-                                  '-Xcc;-pthread;-Xcc;-ftls-model=local-exec')
+                                  '-Xcc;-pthread;-Xcc;-ftls-model=local-exec;'
+                                  '-Xcc;-mtail-call')
         self.cmake_options.define('SWIFT_ENABLE_WASI_THREADS:BOOL', 'TRUE')
