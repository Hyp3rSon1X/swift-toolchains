@@ -301,11 +301,15 @@ class WASIThreadsStdlib(WASIStdlib):
 
     def add_extra_cmake_options(self):
         self.cmake_options.define('SWIFT_THREADING_PACKAGE:STRING', 'pthreads')
+        # -mtail-call enables the tail-call proposal, so clang accepts
